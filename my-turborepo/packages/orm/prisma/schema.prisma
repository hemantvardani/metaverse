// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  uuid  String @id @default(uuid())
  password String @default("")
  userName String @unique
  role Role @default(PLAYER)

  spaces Space[]

  avatarId String?
  avatar Avatar? @relation(fields: [avatarId],references: [uuid])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Map {
  uuid String @default(uuid()) @id
  title String 
  description String
  image String
  height Int
  width Int
  live Boolean @default(false)

  spaces Space[]
  elements MapElement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Space {
  uuid String @default(uuid()) @id
  title String

  mapId String
  map Map @relation(fields: [mapId], references: [uuid])

  userId String
  user User @relation(fields: [userId], references: [uuid])

  elements SpaceElement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Element {
  uuid String @default(uuid()) @id
  title String
  isWalkable Boolean @default(false) // whether can be overlapped
  image String

  MapElements MapElement[]
  SpaceElements SpaceElement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MapElement {
  uuid String @id @default(uuid())
  x Int
  y Int

  elementId String
  element Element @relation(fields: [elementId], references: [uuid])

  mapId String
  map Map @relation(fields: [mapId], references: [uuid])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpaceElement {
  uuid String @id @default(uuid())
  x Int
  y Int

  elementId String
  element Element @relation(fields: [elementId], references: [uuid])

  spaceId String
  space Space @relation(fields: [spaceId], references: [uuid])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Avatar {
  uuid String @default(uuid()) @id
  title String
  image String

  user User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
  
enum Role {
  PLAYER
  ADMIN
}

